[Unit]
Description=fjodor-types: the typewriter page and the drop archive
After=network-online.target
Wants=network-online.target

[Service]
User=fjodor
WorkingDirectory=/opt/fjodor
ExecStart=/usr/bin/java -Xmx128m -jar /opt/fjodor/fjodor.jar
Restart=always
RestartSec=10
SuccessExitStatus=143
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/fjodor

[Install]
WantedBy=multi-user.target
